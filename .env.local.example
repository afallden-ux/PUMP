# Copy to .env.local and fill from Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the Publishable key (sb_publishable_...) or legacy anon key (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Production app URL — used in signup confirmation emails (avoids localhost links)
# Example: https://pump.yourdomain.se or https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron: 72h inactivity emails (Vercel Cron + Resend)
CRON_SECRET=generate_a_long_random_string
# Server-only: legacy "service_role" (eyJ…) OR new "Secret key" (sb_secret_…) — NOT anon/publishable
SUPABASE_SERVICE_ROLE_KEY=eyJ_or_sb_secret_from_supabase_settings_api
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=PUMP <noreply@yourdomain.se>

# External logbook integrations (server-only, 32+ random chars each)
MOONBOARD_SESSION_SECRET=generate_a_long_random_string
# Optional alias used by 27crags / 8a.nu; can match MOONBOARD_SESSION_SECRET
LOGBOOK_SESSION_SECRET=
